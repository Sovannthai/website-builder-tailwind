      "title": "Questions? *Answers.*",
      "subtitle": "Can't find what you're looking for? Our team replies within the hour.",
      "items": [
        {
          "question": "How long does setup take?",
          "answer": "Most teams send their first events within 15 minutes using our snippet or one of 40+ integrations."
        },
        {
          "question": "Do I need a data team to use Lumen?",
          "answer": "No. Lumen is built for product, growth and marketing teams. Questions are answered in plain language, no SQL required."
        },
        {
          "question": "Can I cancel anytime?",
          "answer": "Yes. Plans are month-to-month and you can export all of your data whenever you like."
        },
        {
          "question": "Is my data secure?",
          "answer": "Data is encrypted in transit and at rest, and we're SOC 2 Type II certified. Scale plans add SSO and audit logs."
        },
        {
          "question": "Do you offer discounts for startups or non-profits?",
          "answer": "Yes: 50% off Growth for the first year. Contact us with a few details about your organisation."
        }
